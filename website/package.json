{
  "name": "pspm-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/prebuild.mjs",
    "predev": "node scripts/prebuild.mjs",
    "postinstall": "fumadocs-mdx",
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/check-site-url.mjs",
    "deploy:preview": "SITE_URL=${PREVIEW_URL:-https://preview.pspm-website.pages.dev} npm run build && npm exec --yes --package=wrangler -- wrangler pages deploy out --project-name pspm-website --branch preview",
    "start": "npx serve out -l 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:numbers": "node scripts/check-hardcoded-numbers.mjs",
    "check": "node scripts/check-contrast.mjs && node scripts/check-hardcoded-numbers.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.33",
    "serve": "^14.2.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "fumadocs-core": "^15.8.5",
    "fumadocs-mdx": "^12.0.3",
    "fumadocs-ui": "^15.8.5",
    "next": "^15.5.29",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "zod": "^4.6.7"
  }
}
