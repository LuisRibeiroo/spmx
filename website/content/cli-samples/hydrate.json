    [{ "t": "Scope:", "c": "muted" }, { "t": " ~/.spmx/store" }],
    [],
    [{ "t": "Linked projects:", "b": true }],
    [{ "t": "  › " }, { "t": "~/dimension/c-137", "c": "accent" }, { "t": "  3 pkg(s)  " }, { "t": "1.8 GB", "c": "ok" }],
    [{ "t": "  › " }, { "t": "~/dimension/prime", "c": "accent" }, { "t": "  2 pkg(s)  " }, { "t": "740 MB", "c": "ok" }],
    [{ "t": "  › " }, { "t": "~/dimension/c-131", "c": "accent" }, { "t": "  2 pkg(s)  " }, { "t": "1.4 GB", "c": "ok" }],
    [],
    [{ "t": "Summary:", "b": true }],
    [{ "t": "  Logical size:", "c": "muted" }, { "t": "       2.1 GB", "b": true }],
    [{ "t": "  Projects:", "c": "muted" }, { "t": "           3", "c": "accent", "b": true }, { "t": " total (", "c": "muted" }, { "t": "3 active", "c": "ok" }, { "t": ", 0 missing)", "c": "muted" }],
    [{ "t": "  Total estimated disk saved across machine: ", "c": "muted" }, { "t": "3.94 GB", "c": "ok", "b": true }]
